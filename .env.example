# LLM provider: anthropic | ollama | openai  (switch by changing this one line)
LLM_PROVIDER=ollama

# Anthropic (needs API credits: console.anthropic.com -> Plans & Billing)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
ANTHROPIC_MODEL_STRONG=claude-opus-5-5

# Eval judge: scores eval runs and grader validation only — the app itself stays on LLM_PROVIDER
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-5-5

# Ollama (local)
OLLAMA_MODEL_CHEAP=qwen2.5:7b
OLLAMA_MODEL_STRONG=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
# OLLAMA_MODEL_LIGHT=   # cheap model for easy answers; default = the strong model (an 8 GB GPU can't hold two)

# Model router (agent/model_router.py): template / light / strong per answer
MODEL_ROUTER=on

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Data paths
DATA_PATH=./data/annotated_results.csv
CHROMA_PATH=./chroma_db
PROFILE_CACHE_PATH=./data/profile_cache.json

# CRAG threshold
CRAG_THRESHOLD=0.25

# Neo4j AuraDB (leave NEO4J_URI empty to use the NetworkX fallback)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password

# LangSmith tracing (https://smith.langchain.com → Settings → API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=recognition-agent
